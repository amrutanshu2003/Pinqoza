PORT=5000
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here
JWT_ADMIN_SECRET=your_admin_jwt_secret_here

# Google OAuth (create credentials in Google Cloud Console)
# Redirect URI must match exactly in Google OAuth config.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
# Example: http://localhost:5000/api/users/auth/google/callback
GOOGLE_REDIRECT_URI=

# Gmail SMTP example. Use a Gmail App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="MilkMitra Support <your-email@gmail.com>"
# Inbox where contact/support requests should arrive
CONTACT_TO=owner-inbox@gmail.com
